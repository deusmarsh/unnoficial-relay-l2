+
+/// Preserve a zero contribution when D3D9 shader arithmetic masks a non-finite operand.
+///
+/// An unused light can still evaluate reciprocal attenuation at a zero
+/// denominator. Plain Metal multiplication then propagates `0 * inf` as
+/// NaN into the vertex colour, even though that light's contribution is
+/// zero. Sanitize both operands before evaluating the product; MAD keeps
+/// its existing fused operation for finite inputs and retains the addend
+/// when either multiplicand is zero. Emit only the helpers a shader uses.
+fn emit_legacy_multiply_helpers(out: &mut String, program: &DxsoProgram) {
+    let has_mul = program.instructions.iter().any(|i| i.opcode == Opcode::Mul);
+    let has_mad = program.instructions.iter().any(|i| i.opcode == Opcode::Mad);
+    if !has_mul && !has_mad {
+        return;
+    }
+    w(
+        out,
+        "inline float4 mtld3d_mul_operand(float4 value, float4 other) {\n\
+             return select(value, float4(0.0), other == float4(0.0));\n\
+         }\n\n",
+    );
+    if has_mul {
+        w(
+            out,
+            "inline float4 mtld3d_legacy_mul(float4 a, float4 b) {\n\
+                 return mtld3d_mul_operand(a, b) * mtld3d_mul_operand(b, a);\n\
+             }\n\n",
+        );
+    }
+    if has_mad {
+        w(
+            out,
+            "inline float4 mtld3d_legacy_mad(float4 a, float4 b, float4 c) {\n\
+                 return fma(mtld3d_mul_operand(a, b), mtld3d_mul_operand(b, a), c);\n\
+             }\n\n",
+        );
+    }
 }
 
